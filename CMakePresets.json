{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "Visual Studio 2022 x64",
      "description": "Generate a Visual Studio solution for the NoGraphicsAPI library, examples, and tests.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-msvc",
      "cacheVariables": {
        "NOGRAPHICSAPI_BUILD_EXAMPLES": true,
        "NOGRAPHICSAPI_BUILD_TESTS": true
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "description": "Shared Linux Ninja configuration for the NoGraphicsAPI library, examples, and tests.",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "NOGRAPHICSAPI_BUILD_EXAMPLES": true,
        "NOGRAPHICSAPI_BUILD_TESTS": true,
        "NOGRAPHICSAPI_SLANGC": "$env{SLANGC}",
        "Vulkan_INCLUDE_DIR": "$env{VULKAN_SDK}/include"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux RelWithDebInfo",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build-ninja/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux MinSizeRel",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build-ninja/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "linux-debug",
      "displayName": "Linux RelWithDebInfo",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "displayName": "Linux MinSizeRel",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug tests",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release tests",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux RelWithDebInfo tests",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux MinSizeRel tests",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
